# Environment: testnet or production
BINANCE_ENV=testnet

# Binance Futures Testnet Credentials
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# Binance Futures Production Credentials (Required only if BINANCE_ENV=production)
BINANCE_API_KEY=your_prod_api_key_here
BINANCE_API_SECRET=your_prod_api_secret_here

